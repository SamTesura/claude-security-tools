# MCP Security Server Environment Variables
# Copy this file to .env and configure as needed

# WPScan API Token (optional, get from https://wpscan.com/api)
# Provides vulnerability data for WordPress scans
WPSCAN_API_TOKEN=

# Database path inside container
SCAN_DB_PATH=/data/scans.db

# Results directory path inside container
RESULTS_PATH=/data/results

# Container timezone (optional)
TZ=UTC

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Scope enforcement (fail-closed) ---
# Path (inside the container) to the JSON allowlist of authorized targets.
# docker-compose mounts it at /etc/mcp/scope.json by default. If this is UNSET
# the server REFUSES TO START unless MCP_SCOPE_MODE=audit is also set.
MCP_SCOPE_FILE=/etc/mcp/scope.json

# Host path to your real out-of-tree scope file (overrides the repo example).
# MCP_SCOPE_HOST_FILE=/home/you/engagements/scope.json

# Explicit opt-in to allow-all when no scope file is present. Leave UNSET for
# safety; set to "audit" only for throwaway lab use.
# MCP_SCOPE_MODE=audit

# Hard cap (bytes) on captured tool output returned to the client / written to
# disk. Prevents a chatty scan from flooding the response. Default 2 MiB.
# MAX_OUTPUT_BYTES=2097152